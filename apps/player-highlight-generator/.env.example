# ---------------------------------------------------------------------------
# Player Highlight Generator - environment
# Copy to .env and edit. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# PostgreSQL. The web app and the worker share one database.
DATABASE_URL=postgresql://phg:change-me@localhost:5432/phg
POSTGRES_USER=phg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phg

# Where uploaded video, rendered clips, reels, logos and music live.
# Both the web container and the worker container must mount this same path.
PHG_MEDIA_ROOT=/var/lib/phg/media
PHG_WORK_ROOT=/tmp/phg-work

# Largest accepted upload, in bytes. Default 16 GB, enough for a long game
# recorded at 1080p60 on a phone.
PHG_MAX_UPLOAD_BYTES=17179869184

# --- Matching ---------------------------------------------------------------
# How far either side of the projected instant a play may still be found.
PHG_SEARCH_WINDOW=25
# Extra slack added per minute of distance from the nearest sync anchor.
PHG_DRIFT_PER_MIN=0.35
# At or above this confidence a clip ships without review.
PHG_AUTO_APPROVE=0.80
# Below this it is discarded rather than queued.
PHG_REVIEW_FLOOR=0.45
# Jersey recognition runs only inside this band, and never outside it.
PHG_JERSEY_ENABLED=true
PHG_JERSEY_BAND_LOW=0.45
PHG_JERSEY_BAND_HIGH=0.85
# Hard cap on how far a jersey read may move a confidence score.
PHG_JERSEY_MAX_ADJ=0.18

# --- Clip timing ------------------------------------------------------------
PHG_PRE_ROLL=5
PHG_POST_ROLL=8
PHG_DEAD_TIME=true
PHG_MOTION_THRESHOLD=0.015
PHG_MOTION_SAMPLE_FPS=6
PHG_MIN_KEPT=4

# --- Rendering --------------------------------------------------------------
PHG_FFMPEG=ffmpeg
PHG_FFPROBE=ffprobe
PHG_CRF=20
PHG_PRESET=medium
PHG_MUSIC_DB=-18
PHG_WORKER_NAME=worker-1
PHG_POLL_INTERVAL=3

# --- Web --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Absolute path to shared/column-aliases.json, if the default relative
# resolution does not suit your deployment layout.
# PHG_COLUMN_ALIASES=/app/shared/column-aliases.json
